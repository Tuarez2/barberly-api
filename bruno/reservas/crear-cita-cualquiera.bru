meta {
  name: Crear cita con Cualquiera disponible
  type: http
  seq: 9
}

post {
  url: {{urlBase}}/citas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAcceso}}
}

body:json {
  {
    "barberiaId": "{{barberiaId}}",
    "servicioId": "{{servicioId}}",
    "iniciaEn": "{{iniciaEn}}",
    "claveIdempotencia": "{{claveIdempotencia}}"
  }
}

script:pre-request {
  // Manana a las 15:00 de Guayaquil (UTC-05:00) = 20:00 UTC, en un bloque de 15 minutos.
  const manana = new Date(Date.now() - 5 * 3600000 + 86400000).toISOString().slice(0, 10);
  bru.setVar("iniciaEn", `${manana}T20:00:00.000Z`);
  bru.setVar("claveIdempotencia", require("crypto").randomUUID());
}

assert {
  res.status: eq 201
  res.body.datos.barbero.id: isString
}

docs {
  CU-07 A3. Sin `barberoId`: se asigna el barbero libre con menos citas activas ese día local (empate: menor id) y la respuesta trae su `barbero`. Si todos están ocupados: 409 HORARIO_OCUPADO.
}
